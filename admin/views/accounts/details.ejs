<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <title>EUCheck Admin - Detalii Cont Utilizator</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --card-gradient: linear-gradient(135deg, #1e293b 0%, #090d16 100%);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --accent-blue: #3b82f6;
      --accent-green: #10b981;
      --accent-red: #f87171;
      --border-color: rgba(255, 255, 255, 0.08);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Inter', sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      min-height: 100vh;
      padding-bottom: 50px;
    }

    .navbar {
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-color);
      padding: 1rem 2.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand {
      font-size: 1.25rem;
      font-weight: 700;
      color: #fff;
    }

    .brand span {
      color: var(--accent-blue);
    }

    .nav-links {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      padding: 8px 14px;
      border-radius: 8px;
      font-weight: 500;
      font-size: 0.9rem;
      transition: all 0.2s ease;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: #fff;
      background: rgba(255, 255, 255, 0.06);
    }

    .container {
      max-width: 760px;
      margin: 40px auto;
      padding: 0 24px;
    }

    .card {
      background: var(--card-gradient);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 36px;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.45);
    }

    .header-box {
      margin-bottom: 28px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border-color);
    }

    h2 {
      font-size: 1.6rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 6px;
    }

    .subtitle {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    .details-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
      gap: 16px;
    }

    .detail-item {
      background: rgba(15, 23, 42, 0.55);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 16px 18px;
    }

    .detail-label {
      display: block;
      font-size: 0.78rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
      margin-bottom: 6px;
    }

    .detail-value {
      font-size: 1rem;
      font-weight: 600;
      color: #f8fafc;
      word-break: break-word;
    }

    .badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 0.82rem;
      font-weight: 700;
      background: rgba(59, 130, 246, 0.16);
      color: #60a5fa;
    }

    .status-ok {
      color: var(--accent-green);
    }

    .status-no {
      color: var(--accent-red);
    }

    .footer-actions {
      margin-top: 28px;
      padding-top: 20px;
      border-top: 1px solid var(--border-color);
      display: flex;
      justify-content: flex-start;
    }

    .btn-back {
      display: inline-block;
      background: rgba(255, 255, 255, 0.06);
      color: #e2e8f0;
      text-decoration: none;
      padding: 10px 18px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.9rem;
      border: 1px solid var(--border-color);
      transition: all 0.2s ease;
    }

    .btn-back:hover {
      background: rgba(255, 255, 255, 0.12);
      color: #fff;
    }
  </style>
</head>
<body>

  <header class="navbar">
    <div class="brand">EUCheck <span>Admin</span></div>
    <nav class="nav-links">
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/accounts" class="active">Conturi</a>
      <a href="/admin/standards">Directive UE</a>
      <a href="/admin/logout">Deconectare</a>
    </nav>
  </header>

  <div class="container">
    <div class="card">
      <div class="header-box">
        <h2>Detalii Cont Utilizator</h2>
        <div class="subtitle">Informații de profil, pachet comercial și drepturi active în platformă.</div>
      </div>

      <div class="details-grid">
        <div class="detail-item">
          <span class="detail-label">Email de autentificare</span>
          <div class="detail-value"><%= account.email %></div>
        </div>

        <div class="detail-item">
          <span class="detail-label">Nume Complet / Reprezentant</span>
          <div class="detail-value"><%= account.full_name || 'Nespecificat' %></div>
        </div>

        <div class="detail-item">
          <span class="detail-label">Denumire Firmă &amp; CUI</span>
          <div class="detail-value">
            <% if (account.company_name) { %>
              <%= account.company_name %><%= account.vat_number ? ' | CUI: ' + account.vat_number : '' %>
            <% } else { %>
              Cont individual (fără firmă)
            <% } %>
          </div>
        </div>

        <div class="detail-item">
          <span class="detail-label">Pachet de audit curent</span>
          <div class="detail-value"><span class="badge"><%= account.tier %></span></div>
        </div>

        <div class="detail-item">
          <span class="detail-label">Balanță Credite (Tokeni)</span>
          <div class="detail-value"><%= account.tokens_balance %> scanări disponibile</div>
        </div>

        <div class="detail-item">
          <span class="detail-label">Export Raport PDF</span>
          <div class="detail-value <%= account.can_export_pdf ? 'status-ok' : 'status-no' %>">
            <%= account.can_export_pdf ? 'Activ' : 'Inactiv' %>
          </div>
        </div>

        <div class="detail-item">
          <span class="detail-label">Scanări Nelimitate (Enterprise)</span>
          <div class="detail-value <%= account.has_unlimited_scans ? 'status-ok' : 'status-no' %>">
            <%= account.has_unlimited_scans ? 'Da' : 'Nu' %>
          </div>
        </div>

        <div class="detail-item">
          <span class="detail-label">Rol de Administrator</span>
          <div class="detail-value <%= account.is_admin ? 'status-ok' : 'status-no' %>">
            <%= account.is_admin ? 'DA' : 'NU' %>
          </div>
        </div>

        <div class="detail-item">
          <span class="detail-label">Status Cont</span>
          <div class="detail-value <%= account.is_active ? 'status-ok' : 'status-no' %>">
            <%= account.is_active ? 'Activ' : 'Inactiv' %>
          </div>
        </div>
      </div>

      <div class="footer-actions">
        <a href="/admin/accounts" class="btn-back">&larr; Înapoi la Listă</a>
      </div>
    </div>
  </div>

</body>
</html>