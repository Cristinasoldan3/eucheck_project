<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EUCheck Admin - Editare Regulă Conformitate</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --accent-blue: #3b82f6;
      --accent-green: #10b981;
      --border-color: rgba(255, 255, 255, 0.08);
    }
    * { box-sizing: border-box; font-family: 'Inter', sans-serif; }
    body { background-color: var(--bg-color); color: var(--text-main); min-height: 100vh; padding-bottom: 50px; }

    .container {
      max-width: 750px;
      margin: 40px auto;
      padding: 40px;
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.3);
    }

    h2 { font-size: 1.5rem; font-weight: 600; color: #fff; margin-bottom: 8px; }
    .subtitle { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 30px; }

    .form-group { margin-bottom: 22px; }
    label { display: block; font-weight: 500; font-size: 0.85rem; margin-bottom: 8px; color: #cbd5e1; text-transform: uppercase; letter-spacing: 0.5px; }

    input[type="text"], input[type="number"], select, textarea {
      width: 100%;
      padding: 12px 16px;
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      color: #fff;
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.2s;
    }
    input[type="text"]:focus, input[type="number"]:focus, select:focus, textarea:focus { border-color: var(--accent-blue); }
    select option { background: #1e293b; color: #fff; }
    textarea { resize: vertical; min-height: 100px; }

    .checkbox-group {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 15px;
      padding: 12px 16px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      cursor: pointer;
    }
    .checkbox-group input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--accent-blue); cursor: pointer; }
    .checkbox-group label { margin-bottom: 0; cursor: pointer; color: #e2e8f0; text-transform: none; font-size: 0.95rem; font-weight: 500; }

    .actions-row {
      display: flex;
      gap: 15px;
      align-items: center;
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid var(--border-color);
    }

    .btn-submit {
      flex: 1;
      background: var(--accent-blue); color: white;
      padding: 12px; border: none; border-radius: 8px;
      font-size: 1rem; font-weight: 600; cursor: pointer;
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3); transition: background 0.2s;
    }
    .btn-submit:hover { background: #2563eb; }

    .btn-cancel {
      background: rgba(255, 255, 255, 0.05); color: var(--text-muted);
      padding: 12px 20px; border-radius: 8px; text-decoration: none;
      font-weight: 500; font-size: 0.9rem; border: 1px solid var(--border-color);
      text-align: center; transition: all 0.2s;
    }
    .btn-cancel:hover { background: rgba(255, 255, 255, 0.1); color: #fff; }

    .back-link {
      display: block; text-align: center; margin-top: 20px;
      color: var(--text-muted); text-decoration: none; font-size: 0.9rem;
    }
    .back-link:hover { color: #fff; }
  </style>
</head>
<body>

  <% const current = 'rules'; %>
  <header class="bg-[#0f172a]/70 backdrop-blur-xl border-b border-slate-800/80 sticky top-0 z-50 px-8 py-4 flex justify-between items-center transition-all duration-300">
      <a href="/admin/dashboard" class="flex items-center space-x-3 group">
          <div class="bg-gradient-to-tr from-indigo-600 to-violet-500 text-white p-2.5 rounded-2xl shadow-lg shadow-indigo-500/20 group-hover:scale-110 transition-transform duration-300">
              <i class="fa-solid fa-shield-halved text-lg"></i>
          </div>
          <div>
              <span class="text-lg font-black tracking-wider text-white">EUCHECK </span>
              <span class="block text-[10px] text-slate-400 font-semibold tracking-widest uppercase">Admin Security</span>
          </div>
      </a>

      <nav class="hidden lg:flex space-x-1 bg-slate-900/80 p-1.5 rounded-2xl border border-slate-800/80 backdrop-blur-md">
          <a href="/admin/dashboard" class="px-4 py-2 rounded-xl text-xs transition-all <%= current === 'dashboard' ? 'bg-indigo-600 text-white font-bold shadow-lg shadow-indigo-600/30' : 'text-slate-400 hover:text-white hover:bg-slate-800/50 font-medium' %>">Dashboard</a>
          <a href="/admin/accounts" class="px-4 py-2 rounded-xl text-xs transition-all <%= current === 'accounts' ? 'bg-indigo-600 text-white font-bold shadow-lg shadow-indigo-600/30' : 'text-slate-400 hover:text-white hover:bg-slate-800/50 font-medium' %>">Conturi</a>
          <a href="/admin/standards" class="px-4 py-2 rounded-xl text-xs transition-all <%= current === 'standards' ? 'bg-indigo-600 text-white font-bold shadow-lg shadow-indigo-600/30' : 'text-slate-400 hover:text-white hover:bg-slate-800/50 font-medium' %>">Directive UE</a>
          <a href="/admin/rules" class="px-4 py-2 rounded-xl text-xs transition-all <%= current === 'rules' ? 'bg-indigo-600 text-white font-bold shadow-lg shadow-indigo-600/30' : 'text-slate-400 hover:text-white hover:bg-slate-800/50 font-medium' %>">Reguli</a>
          <a href="/admin/plans" class="px-4 py-2 rounded-xl text-xs transition-all <%= current === 'plans' ? 'bg-indigo-600 text-white font-bold shadow-lg shadow-indigo-600/30' : 'text-slate-400 hover:text-white hover:bg-slate-800/50 font-medium' %>">Pachete</a>
          <a href="/admin/logs" class="px-4 py-2 rounded-xl text-xs transition-all <%= current === 'logs' ? 'bg-indigo-600 text-white font-bold shadow-lg shadow-indigo-600/30' : 'text-slate-400 hover:text-white hover:bg-slate-800/50 font-medium' %>">Jurnal</a>
      </nav>

      <div class="flex items-center space-x-3 bg-slate-900/80 border border-slate-800/80 px-4 py-2 rounded-2xl shadow-inner">
          <div class="relative flex items-center justify-center">
              <div class="w-2.5 h-2.5 rounded-full bg-emerald-500"></div>
              <div class="absolute w-4 h-4 rounded-full bg-emerald-500/40 animate-ping"></div>
          </div>
          <span class="text-xs font-bold text-slate-300 tracking-wide"><%= typeof admin !== 'undefined' && admin ? admin.email : 'admin.eucheck@gmail.com' %></span>
          <a href="/admin/logout" title="Deconectare" class="text-slate-400 hover:text-rose-400 transition ml-2 pl-2 border-l border-slate-700">
              <i class="fa-solid fa-power-off text-xs"></i>
          </a>
      </div>
  </header>

  <div class="container">
    <h2>Editare Regulă de Conformitate</h2>
    <div class="subtitle">Modifică clauza tehnică, standardul părinte și ponderea de audit.</div>

    <form action="/admin/rules/<%= rule.id %>/edit" method="POST">

      <div class="form-group">
        <label>Standard Părinte (Directivă UE):</label>
        <select name="standard_id" required>
          <% if (typeof standards !== 'undefined' && standards.length > 0) { %>
            <% standards.forEach(function(std) { %>
              <option value="<%= std.id %>" <%= rule.standard_id === std.id ? 'selected' : '' %>>
                <%= std.code || std.directive_code %> - <%= std.title || std.name %>
              </option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <div class="form-group">
        <label>Referință Clauză / Articol:</label>
        <input type="text" name="clause_reference" value="<%= rule.clause_reference || rule.clause || '' %>" required />
      </div>

      <div class="form-group">
        <label>Titlu Regulă:</label>
        <input type="text" name="title" value="<%= rule.title || rule.name || '' %>" required />
      </div>

      <div class="form-group">
        <label>Pondere Punctaj Audit (pct):</label>
        <input type="number" name="weight" value="<%= rule.weight || 10 %>" required />
      </div>

      <div class="form-group">
        <label>Recomandare / Explicație Tehnică:</label>
        <textarea name="recommendation"><%= rule.recommendation || '' %></textarea>
      </div>

      <div class="checkbox-group">
        <input type="checkbox" id="is_mandatory" name="is_mandatory" <%= rule.is_mandatory !== false ? 'checked' : '' %> />
        <label for="is_mandatory">Regulă obligatorie în cadrul auditului de conformitate</label>
      </div>

      <div class="actions-row">
        <button type="submit" class="btn-submit">Salvează Modificările</button>
        <a href="/admin/rules" class="btn-cancel">Anulează</a>
      </div>
    </form>

    <a href="/admin/rules" class="back-link">&larr; Înapoi la Lista de Reguli</a>
  </div>

</body>
</html>