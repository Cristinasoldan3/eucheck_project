<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EUCheck Admin - Jurnal de Audit</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-[#090d16] text-slate-100 min-h-screen font-sans">

    <% const current = 'logs'; %>
    <% const logsList = typeof adminLogs !== 'undefined' && Array.isArray(adminLogs) ? adminLogs : []; %>

    <!-- NAVBAR SUPERIOR -->
    <header class="bg-[#0f172a]/70 backdrop-blur-xl border-b border-slate-800/80 sticky top-0 z-50 px-8 py-4 flex justify-between items-center transition-all duration-300">
        <a href="/admin/dashboard" class="flex items-center space-x-3 group">
            <div class="bg-gradient-to-tr from-indigo-600 to-violet-500 text-white p-2.5 rounded-2xl shadow-lg shadow-indigo-500/20 group-hover:scale-110 transition-transform duration-300">
                <i class="fa-solid fa-shield-halved text-lg"></i>
            </div>
            <div>
                <span class="text-lg font-black tracking-wider text-white">EUCHECK </span>
                <span class="block text-[10px] text-slate-400 font-semibold tracking-widest uppercase">Admin Security</span>
            </div>
        </a>

        <nav class="hidden lg:flex space-x-1 bg-slate-900/80 p-1.5 rounded-2xl border border-slate-800/80 backdrop-blur-md">
            <a href="/admin/dashboard" class="px-4 py-2 rounded-xl text-xs transition-all <%= current === 'dashboard' ? 'bg-indigo-600 text-white font-bold shadow-lg shadow-indigo-600/30' : 'text-slate-400 hover:text-white hover:bg-slate-800/50 font-medium' %>">Dashboard</a>
            <a href="/admin/accounts" class="px-4 py-2 rounded-xl text-xs transition-all <%= current === 'accounts' ? 'bg-indigo-600 text-white font-bold shadow-lg shadow-indigo-600/30' : 'text-slate-400 hover:text-white hover:bg-slate-800/50 font-medium' %>">Conturi</a>
            <a href="/admin/standards" class="px-4 py-2 rounded-xl text-xs transition-all <%= current === 'standards' ? 'bg-indigo-600 text-white font-bold shadow-lg shadow-indigo-600/30' : 'text-slate-400 hover:text-white hover:bg-slate-800/50 font-medium' %>">Directive UE</a>
            <a href="/admin/rules" class="px-4 py-2 rounded-xl text-xs transition-all <%= current === 'rules' ? 'bg-indigo-600 text-white font-bold shadow-lg shadow-indigo-600/30' : 'text-slate-400 hover:text-white hover:bg-slate-800/50 font-medium' %>">Reguli</a>
            <a href="/admin/plans" class="px-4 py-2 rounded-xl text-xs transition-all <%= current === 'plans' ? 'bg-indigo-600 text-white font-bold shadow-lg shadow-indigo-600/30' : 'text-slate-400 hover:text-white hover:bg-slate-800/50 font-medium' %>">Pachete</a>
            <a href="/admin/logs" class="px-4 py-2 rounded-xl text-xs transition-all <%= current === 'logs' ? 'bg-indigo-600 text-white font-bold shadow-lg shadow-indigo-600/30' : 'text-slate-400 hover:text-white hover:bg-slate-800/50 font-medium' %>">Jurnal</a>
        </nav>

        <div class="flex items-center space-x-3 bg-slate-900/80 border border-slate-800/80 px-4 py-2 rounded-2xl shadow-inner">
            <div class="relative flex items-center justify-center">
                <div class="w-2.5 h-2.5 rounded-full bg-emerald-500"></div>
                <div class="absolute w-4 h-4 rounded-full bg-emerald-500/40 animate-ping"></div>
            </div>
            <span class="text-xs font-bold text-slate-300 tracking-wide"><%= typeof admin !== 'undefined' && admin ? admin.email : 'admin.eucheck@gmail.com' %></span>
            <a href="/admin/logout" title="Deconectare" class="text-slate-400 hover:text-rose-400 transition ml-2 pl-2 border-l border-slate-700">
                <i class="fa-solid fa-power-off text-xs"></i>
            </a>
        </div>
    </header>

    <!-- CONTINUT PRINCIPAL -->
    <main class="max-w-7xl mx-auto px-6 py-10">

        <!-- HEADER PAGINA -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 bg-gradient-to-r from-slate-900/90 via-slate-900/50 to-indigo-950/40 p-8 rounded-3xl border border-slate-800 shadow-2xl backdrop-blur-xl">
            <div>
                <span class="px-3 py-1 bg-indigo-500/10 border border-indigo-500/30 text-indigo-400 rounded-full text-[11px] font-bold uppercase tracking-wider mb-3 inline-block">
                    <i class="fa-solid fa-clock-rotate-left mr-1.5"></i> Securitate & Monitorizare
                </span>
                <h1 class="text-3xl font-black text-white tracking-tight mb-2">Jurnalul de Activitate & Audit</h1>
                <p class="text-slate-400 text-sm">Istoricul complet al modificărilor efectuate în panoul de control administrativ.</p>
            </div>
            <div class="mt-4 md:mt-0 flex items-center space-x-3">
                <a href="/admin/dashboard" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold px-5 py-3 rounded-2xl transition border border-slate-700 flex items-center space-x-2">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Înapoi la Dashboard</span>
                </a>
            </div>
        </div>

        <!-- FILTRU / CĂUTARE DUPĂ ZI (FRONT-END) -->
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-2xl p-5 mb-6 backdrop-blur-xl shadow-xl flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
            <div class="flex flex-col sm:flex-row sm:items-center gap-3">
                <label for="feDateFilter" class="text-xs font-bold uppercase tracking-wider text-slate-300 flex items-center space-x-2">
                    <i class="fa-regular fa-calendar text-indigo-400"></i>
                    <span>Filtrează după zi:</span>
                </label>
                <input
                    type="date"
                    id="feDateFilter"
                    class="bg-slate-900 border border-slate-700 focus:border-indigo-500 text-slate-100 text-xs font-semibold px-4 py-2.5 rounded-xl outline-none transition"
                />
            </div>

            <div class="flex items-center gap-2">
                <button
                    type="button"
                    id="feResetDateBtn"
                    class="hidden bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold px-4 py-2.5 rounded-xl transition border border-slate-700 items-center space-x-1.5"
                >
                    <i class="fa-solid fa-rotate-left"></i>
                    <span>Toate zilele</span>
                </button>
            </div>
        </div>

        <!-- LISTA DE JURNAL / TIMELINE -->
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-3xl p-8 backdrop-blur-xl shadow-2xl">

            <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-slate-800/80">
                <div class="flex items-center space-x-3">
                    <div class="p-2.5 bg-indigo-500/10 text-indigo-400 rounded-xl">
                        <i class="fa-solid fa-list-check"></i>
                    </div>
                    <h2 class="text-lg font-bold text-white">
                        Înregistrări Active în Sistem
                        <span id="feActiveDayLabel" class="text-xs font-semibold text-indigo-400 ml-2"></span>
                    </h2>
                </div>
                <div class="flex items-center gap-2">
                    <span id="feCountBadge" class="text-xs font-semibold px-3 py-1 bg-slate-900 border border-slate-800 text-slate-300 rounded-full">
                        Total: <%= logsList.length %> acțiuni
                    </span>
                    <span id="fePageBadge" class="text-xs font-semibold px-3 py-1 bg-slate-900 border border-slate-800 text-slate-400 rounded-full">
                        Pagina 1 / 1
                    </span>
                </div>
            </div>

            <div id="feLogsContainer" class="space-y-4"></div>

            <div id="feEmptyState" class="hidden text-center py-16 text-slate-500">
                <i class="fa-solid fa-folder-open text-4xl mb-3 opacity-40"></i>
                <p id="feEmptyText" class="text-sm">Nu există nicio înregistrare în jurnalul de audit momentan.</p>
            </div>

            <!-- PAGINARE FE (CÂTE 3 / PAGINĂ) -->
            <div id="fePaginationBar" class="hidden mt-8 pt-6 border-t border-slate-800/80 items-center justify-between">
                <button
                    type="button"
                    id="fePrevBtn"
                    class="px-4 py-2.5 rounded-xl text-xs font-bold transition border bg-slate-900 hover:bg-slate-800 text-slate-200 border-slate-700 disabled:opacity-40 disabled:pointer-events-none"
                >
                    &larr; Anterior
                </button>

                <span id="fePaginationInfo" class="text-xs font-semibold text-slate-400"></span>

                <button
                    type="button"
                    id="feNextBtn"
                    class="px-4 py-2.5 rounded-xl text-xs font-bold transition border bg-indigo-600 hover:bg-indigo-500 text-white border-indigo-500 shadow-lg shadow-indigo-600/20 disabled:opacity-40 disabled:pointer-events-none"
                >
                    Următor &rarr;
                </button>
            </div>

        </div>

    </main>

    <footer class="max-w-7xl mx-auto px-6 py-10 mt-12 border-t border-slate-800/80 text-center text-xs text-slate-500">
        EUCheck Platform &bull; Jurnal de Audit Securizat &copy; 2026
    </footer>

    <script>
        (() => {
            const allLogs = JSON.parse(decodeURIComponent("<%= encodeURIComponent(JSON.stringify(logsList || [])) %>"));
            const pageSize = 3;
            let currentPage = 1;
            let selectedDate = '';

            const dateInput = document.getElementById('feDateFilter');
            const resetBtn = document.getElementById('feResetDateBtn');
            const activeDayLabel = document.getElementById('feActiveDayLabel');
            const countBadge = document.getElementById('feCountBadge');
            const pageBadge = document.getElementById('fePageBadge');
            const container = document.getElementById('feLogsContainer');
            const emptyState = document.getElementById('feEmptyState');
            const emptyText = document.getElementById('feEmptyText');
            const paginationBar = document.getElementById('fePaginationBar');
            const paginationInfo = document.getElementById('fePaginationInfo');
            const prevBtn = document.getElementById('fePrevBtn');
            const nextBtn = document.getElementById('feNextBtn');

            const escapeHtml = (val) => String(val ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');

            const getFilteredLogs = () => {
                if (!selectedDate) return allLogs;
                return allLogs.filter((item) => item.dateISO === selectedDate);
            };

            const render = () => {
                const filtered = getFilteredLogs();
                const totalItems = filtered.length;
                const totalPages = Math.max(1, Math.ceil(totalItems / pageSize));
                if (currentPage > totalPages) currentPage = totalPages;

                const start = (currentPage - 1) * pageSize;
                const pageItems = filtered.slice(start, start + pageSize);

                activeDayLabel.textContent = selectedDate ? `(• Ziua: ${selectedDate})` : '';
                countBadge.textContent = selectedDate
                    ? `Găsite: ${totalItems} acțiuni`
                    : `Total: ${totalItems} acțiuni`;
                pageBadge.textContent = `Pagina ${currentPage} / ${totalPages}`;

                if (selectedDate) {
                    resetBtn.classList.remove('hidden');
                    resetBtn.classList.add('flex');
                } else {
                    resetBtn.classList.add('hidden');
                    resetBtn.classList.remove('flex');
                }

                if (pageItems.length === 0) {
                    container.innerHTML = '';
                    emptyState.classList.remove('hidden');
                    emptyText.textContent = selectedDate
                        ? `Nu există înregistrări în jurnal pentru ziua ${selectedDate}.`
                        : 'Nu există nicio înregistrare în jurnalul de audit momentan.';
                } else {
                    emptyState.classList.add('hidden');
                    container.innerHTML = pageItems.map((log) => `
                        <div class="bg-slate-900/60 border border-slate-800/80 hover:border-indigo-500/40 p-5 rounded-2xl transition-all duration-300 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 group">
                            <div class="flex items-start space-x-4">
                                <div class="p-3 bg-indigo-600/10 text-indigo-400 rounded-2xl mt-1 group-hover:scale-110 group-hover:bg-indigo-600 group-hover:text-white transition-all duration-300">
                                    <i class="fa-solid fa-pen-to-square text-base"></i>
                                </div>
                                <div>
                                    <div class="flex items-center space-x-2 mb-1">
                                        <span class="px-2.5 py-0.5 bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 text-[10px] font-black uppercase tracking-wider rounded-md">
                                            ${escapeHtml(log.action)}
                                        </span>
                                        <span class="text-xs text-slate-400 font-medium">${escapeHtml(log.user)}</span>
                                    </div>
                                    <p class="text-sm font-bold text-slate-100">${escapeHtml(log.details)}</p>
                                </div>
                            </div>
                            <div class="flex items-center space-x-2 text-xs font-semibold text-slate-400 bg-slate-950/60 px-3.5 py-2 rounded-xl border border-slate-800/80">
                                <i class="fa-regular fa-clock text-indigo-400"></i>
                                <span>${escapeHtml(log.timestamp)}</span>
                            </div>
                        </div>
                    `).join('');
                }

                if (totalPages > 1) {
                    paginationBar.classList.remove('hidden');
                    paginationBar.classList.add('flex');
                    paginationInfo.innerHTML = ` Pagina <strong class="text-white">${currentPage}</strong> din <strong class="text-white">${totalPages}</strong>`;
                    prevBtn.disabled = currentPage <= 1;
                    nextBtn.disabled = currentPage >= totalPages;
                } else {
                    paginationBar.classList.add('hidden');
                    paginationBar.classList.remove('flex');
                }
            };

            dateInput.addEventListener('change', (e) => {
                selectedDate = e.target.value || '';
                currentPage = 1;
                render();
            });

            resetBtn.addEventListener('click', () => {
                selectedDate = '';
                dateInput.value = '';
                currentPage = 1;
                render();
            });

            prevBtn.addEventListener('click', () => {
                if (currentPage > 1) {
                    currentPage -= 1;
                    render();
                }
            });

            nextBtn.addEventListener('click', () => {
                const totalPages = Math.max(1, Math.ceil(getFilteredLogs().length / pageSize));
                if (currentPage < totalPages) {
                    currentPage += 1;
                    render();
                }
            });

            render();
        })();
    </script>

</body>
</html>